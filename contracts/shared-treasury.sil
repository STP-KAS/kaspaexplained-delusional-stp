pragma silverscript ^0.1.0;
// Two distinct members authorize a payment to the agreed beneficiary.
contract SharedTreasury(pubkey memberA, pubkey memberB, pubkey memberC, int principal, int maxFee) {
    entry spend(sig first, sig second, int pair, pubkey beneficiary) {
        require(memberA != memberB && memberA != memberC && memberB != memberC);
        if(pair == 0) {
            require(checkSig(first, memberA)); require(checkSig(second, memberB));
        } else if(pair == 1) {
            require(checkSig(first, memberA)); require(checkSig(second, memberC));
        } else {
            require(pair == 2);
            require(checkSig(first, memberB)); require(checkSig(second, memberC));
        }
        require(principal > 0 && principal <= 100000000);
        require(maxFee >= 0 && maxFee <= 1000000);
        require(tx.inputs.length == 1 && tx.outputs.length == 1);
        require(tx.inputs[0].value == principal);
        int fee = principal - tx.outputs[0].value;
        require(fee >= 0 && fee <= maxFee && tx.outputs[0].value > 0);
        byte[36] destination = new ScriptPubKeyP2PK(beneficiary);
        require(tx.outputs[0].scriptPubKey == byte[](destination));
    }
}
